<!DOCTYPE html>
<html lang="hu">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Books List</title>
  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body class="bg-light">
    <%- include('header') %>
  <div class="container py-4">
    <h1 class="mb-4 text-center">📚 Books List</h1>
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-3 gap-2">
        <input type="text" id="searchInput" class="form-control w-100 w-md-auto" placeholder="Keresés cím, szerző vagy ISBN alapján">
      </div>
      
    <div class="table-responsive">
        <table class="table table-hover table-bordered align-middle text-center">
          <thead class="table-dark">
            <tr>
              <th>Cover</th>
              <th>Author</th>
              <th>Title</th>
              <th>ISBN</th>
            </tr>
          </thead>
          <tbody id="bookTableBody">
            <% books.forEach(book => { %>
              <tr
                class="book-row"
                data-title="<%= book.title %>"
                data-author="<%= book.author %>"
                data-isbn="<%= book.isbn %>"
                data-rating="<%= book.rating || 0 %>">
                <td><img src="https://covers.openlibrary.org/b/isbn/<%= book.isbn %>-S.jpg?default=false" /></td>
                <td><%= book.author %></td>
                <td><a href="/book/<%= book.isbn %>"><%= book.title %></a></td>
                <td><%= book.isbn || "-" %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>



  <!-- Bootstrap JS Bundle -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script>
  
  document.addEventListener("DOMContentLoaded", () => {
  const searchInput = document.getElementById("searchInput");
  const sortBtn = document.getElementById("sortBtn");
  const bookTableBody = document.getElementById("bookTableBody");
  const rows = Array.from(bookTableBody.querySelectorAll(".book-row"));
  let sortedAsc = false;

  searchInput.addEventListener("input", () => {
    const query = searchInput.value.toLowerCase();

    rows.forEach(row => {
      const title = row.dataset.title.toLowerCase();
      const author = row.dataset.author.toLowerCase();
      const isbn = row.dataset.isbn.toLowerCase();

      if (title.includes(query) || author.includes(query) || isbn.includes(query)) {
        row.style.display = "";
      } else {
        row.style.display = "none";
      }
    });
  });

});



  </script>
</body>
</html>
