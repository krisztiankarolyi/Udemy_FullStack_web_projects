<!DOCTYPE html>
<html lang="hu">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Books List</title>
  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body class="bg-light">
    <%- include('header') %>
  <div class="container py-4">
    <h1 class="mb-4 text-center">📚 Books List (added by all users)</h1>
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-3 gap-2">
        <input type="text" id="searchInput" class="form-control w-100 w-md-auto"  placeholder="Search books by ISBN / Title / Author ...">
      </div>
      
    <div class="table-responsive">
        <table class="table table-hover table-bordered align-middle text-center">
          <thead class="table-dark">
            <tr>
              <th>Cover</th>
              <th id="author-header" style="cursor:pointer;">Author ⬍</th>
              <th id="title-header" style="cursor:pointer;">Title ⬍</th>
              <th>ISBN</th>
              <th id="avg-header" style="cursor:pointer;">Avg Rating ⬍</th>
            </tr>
          </thead>
          
          <tbody id="bookTableBody">
            <% books.forEach(book => { %>
              <tr
                class="book-row"
                data-title="<%= book.title %>"
                data-author="<%= book.author %>"
                data-isbn="<%= book.isbn %>"
                data-avg="<%= book.avg_rating || 0 %>">
                <td>
                  <img src="https://covers.openlibrary.org/b/isbn/<%= book.isbn %>-S.jpg?default=false" alt="Cover" />
                </td>
                <td><%= book.author %></td>
                <td><a href="/book/<%= book.isbn %>"><%= book.title %></a></td>
                <td><%= book.isbn || "-" %></td>
                <td><%= book.avg_rating ? book.avg_rating : "-" %></td>
              </tr>
            <% }) %>
          </tbody>
          
        </table>
      </div>



  <!-- Bootstrap JS Bundle -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    // A backendből kapott könyvek adatai
    const booksData = <%- JSON.stringify(books) %>;
  
    // Kereső és rendezés elemek
    const searchInput = document.getElementById("searchInput");
    const bookTableBody = document.getElementById("bookTableBody");
    const authorHeader = document.getElementById("author-header");
    const titleHeader = document.getElementById("title-header");
    const avgHeader = document.getElementById("avg-header");
  
    // A teljes sorok tömbje (ez a változó minden renderelés után újraszinkronizálódik)
    let rows = Array.from(document.querySelectorAll(".book-row"));
  
    // Rendezési állapotok
    let sortAscAuthor = true;
    let sortAscTitle = true;
    let sortAscAvg = true;
  
    // Újrarenderelő függvény, ami frissíti a táblát a kapott könyv adatokkal
    function renderBooks(books) {
      bookTableBody.innerHTML = books.map(book => `
        <tr 
          class="book-row"
          data-title="${book.title}"
          data-author="${book.author}"
          data-isbn="${book.isbn}"
          data-avg="${book.avg_rating || 0}">
          <td>
            <img src="https://covers.openlibrary.org/b/isbn/${book.isbn}-S.jpg?default=false" alt="Cover" />
          </td>
          <td>${book.author}</td>
          <td><a href="/book/${book.isbn}">${book.title}</a></td>
          <td>${book.isbn || "-"}</td>
          <td>${book.avg_rating ? book.avg_rating : "-"}</td>
        </tr>
      `).join('');
  
      // Frissítjük a sor tömbjét, így a keresés a legfrissebb sorokon fut
      rows = Array.from(document.querySelectorAll(".book-row"));
    }
  
    // Rendezés author szerint
    authorHeader.addEventListener('click', () => {
      const sorted = [...booksData].sort((a, b) => {
        return sortAscAuthor 
          ? a.author.localeCompare(b.author)
          : b.author.localeCompare(a.author);
      });
      sortAscAuthor = !sortAscAuthor;
      authorHeader.innerText = `Author ${sortAscAuthor ? '⬇️' : '⬆️'}`;
      renderBooks(sorted);
    });
  
    // Rendezés title szerint
    titleHeader.addEventListener('click', () => {
      const sorted = [...booksData].sort((a, b) => {
        return sortAscTitle
          ? a.title.localeCompare(b.title)
          : b.title.localeCompare(a.title);
      });
      sortAscTitle = !sortAscTitle;
      titleHeader.innerText = `Title ${sortAscTitle ? '⬇️' : '⬆️'}`;
      renderBooks(sorted);
    });
  
    // Rendezés avg rating szerint
    avgHeader.addEventListener('click', () => {
      const sorted = [...booksData].sort((a, b) => {
        // Átlag értéknél számként hasonlítunk (ha nincs érték, 0-val helyettesítjük)
        const aAvg = parseFloat(a.avg_rating) || 0;
        const bAvg = parseFloat(b.avg_rating) || 0;
        return sortAscAvg
          ? aAvg - bAvg
          : bAvg - aAvg;
      });
      sortAscAvg = !sortAscAvg;
      avgHeader.innerText = `Avg Rating ${sortAscAvg ? '⬇️' : '⬆️'}`;
      renderBooks(sorted);
    });
  
    // Keresés – author, title és isbn alapján
    searchInput.addEventListener("input", () => {
      const query = searchInput.value.toLowerCase();
      rows.forEach(row => {
        const title = row.dataset.title.toLowerCase();
        const author = row.dataset.author.toLowerCase();
        const isbn = row.dataset.isbn.toLowerCase();
  
        if (title.includes(query) || author.includes(query) || isbn.includes(query)) {
          row.style.display = "";
        } else {
          row.style.display = "none";
        }
      });
    });
  </script>
  
</body>
</html>
