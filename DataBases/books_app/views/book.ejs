<!DOCTYPE html>
<html lang="hu">
<head>
  <meta charset="UTF-8">
  <title>Könyv részletei</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <%- include('header') %>
  <style>
    .book-cover {
      max-width: 100%;
      height: auto;
    }
    .star-rating {
      display: flex;
      gap: 2px;
    }
    .star {
      width: 20px;
      height: 20px;
      background-color: #ccc;
      clip-path: polygon(50% 0%, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%);
    }
    .star.filled {
      background-color: gold;
    }
  </style>
</head>
<body>
  <div class="container my-5">
    <div class="row justify-content-center">
      <div class="col-md-8">
        <div class="card shadow-sm">
          <div class="row g-0">
            <div class="col-md-4 text-center p-3">
              <img id="cover" src="" alt="Borító" class="book-cover img-fluid rounded">
            </div>
            <div class="col-md-8">
              <div class="card-body">
                <h2 id="title" class="card-title"></h2>
                <p id="author" class="card-text text-muted"></p>
                <p><strong>ISBN:</strong> <span id="isbn"></span></p>
                <p><strong>Átlagos értékelés:</strong> <span id="rating"></span></p>

                <!-- Form, ha a felhasználó még nem értékelt -->
                <div id="rating-form-container" class="my-4"></div>

                <h5>Felhasználói értékelések:</h5>
                <ul id="reviews" class="list-group"></ul>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

  <script>
    const isbn = "<%= isbn %>";
    const hasRated = <%= hasRated %>;

    document.addEventListener('DOMContentLoaded', async () => {
      try {
        const response = await fetch(`/api/book/${isbn}`);
        if (!response.ok) throw new Error('A könyv nem található.');

        const book = await response.json();

        document.getElementById('cover').src = book.coverURL;
        document.getElementById('title').textContent = book.title || 'N/A';
        document.getElementById('author').textContent = book.author || 'N/A';
        document.getElementById('isbn').textContent = book.isbn || 'N/A';

        const avgRating = book.avg_rating ? parseFloat(book.avg_rating) : 0;
        const ratingText = `${avgRating.toFixed(1)} / 10`;
        const ratingElement = document.getElementById('rating');
        ratingElement.textContent = ratingText;

        const starContainer = document.createElement('div');
        starContainer.classList.add('star-rating');
        for (let i = 0; i < 5; i++) {
          const star = document.createElement('span');
          star.classList.add('star');
          if (i < getStarRating(avgRating)) {
            star.classList.add('filled');
          }
          starContainer.appendChild(star);
        }
        ratingElement.appendChild(starContainer);

        const reviewsList = document.getElementById('reviews');
        if (book.reviews && book.reviews.length > 0) {
          book.reviews.forEach(review => {
            const li = document.createElement('li');
            li.classList.add('list-group-item');

            const avatar = document.createElement('img');
            avatar.src = '/images/avatar.png';
            avatar.alt = `${review.user} avatar`;
            avatar.width = 25;
            avatar.height = 25;
            avatar.classList.add('me-2');

            const text = document.createElement('span');
            text.textContent = `${review.user}: ${review.rating}/10 - ${review.note}`;

            li.appendChild(avatar);
            li.appendChild(text);
            reviewsList.appendChild(li);
          });
        } else {
          const li = document.createElement('li');
          li.classList.add('list-group-item');
          li.textContent = 'Még senki sem értékelte ezt a könyvet.';
          reviewsList.appendChild(li);
        }

        // Értékelő form megjelenítése
        if (!hasRated) {
          const formContainer = document.getElementById('rating-form-container');
          formContainer.innerHTML = `
            <h5>Értékeld a könyvet:</h5>
            <form id="rating-form">
              <div class="mb-2">
                <label for="rating" class="form-label">Pontszám (1-10)</label>
                <input type="number" id="rating-input" name="rating" min="1" max="10" class="form-control" required>
              </div>
              <div class="mb-2">
                <label for="note" class="form-label">Megjegyzés</label>
                <textarea id="note-input" name="note" rows="2" class="form-control" required></textarea>
              </div>
              <button type="submit" class="btn btn-primary">Értékelés mentése</button>
            </form>
          `;

          document.getElementById('rating-form').addEventListener('submit', async (e) => {
            e.preventDefault();
            const rating = document.getElementById('rating-input').value;
            const note = document.getElementById('note-input').value;

            const res = await fetch(`/api/book/${isbn}/rate`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ rating, note })
            });

            if (res.ok) {
              location.reload();
            } else {
              if(res.status == 400)
                 alert("Már értékelted ezt a könyvet");
              else
              alert("nem sikerült menteni az értékelést");
            }
          });
        }
      } catch (error) {
        console.error(error);
        document.getElementById('book-container').innerHTML = '<p class="text-danger">Hiba történt a könyv betöltésekor.</p>';
      }
    });

    function getStarRating(avgRating) {
      if (avgRating >= 7.1) return 5;
      if (avgRating >= 5.1) return 4;
      if (avgRating >= 3.1) return 3;
      if (avgRating >= 1.1) return 2;
      return 1;
    }
  </script>
</body>
</html>
