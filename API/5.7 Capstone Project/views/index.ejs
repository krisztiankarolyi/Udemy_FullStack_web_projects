<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" type="text/css" href="../public/styles/main.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <title>Crypto Portfolio</title>
    <script>       
        function updateButtons() {
            const rows = document.querySelectorAll("#cryptoTable tbody tr");
            rows.forEach((row, index) => {
                const actionCell = row.querySelector("td:last-child");
                actionCell.innerHTML = ""; // Töröljük az összes gombot

                if (rows.length > 1) {
                    const removeButton = document.createElement("button");
                    removeButton.textContent = "-";
                    removeButton.setAttribute("type", "button");
                    removeButton.classList.add("btn", "btn-outline-danger", "me-1");
                    removeButton.onclick = () => { removeRow(row); };
                    actionCell.appendChild(removeButton);
                }

                if (index === rows.length - 1) {
                    const addButton = document.createElement("button");
                    addButton.textContent = "+";
                    addButton.setAttribute("type", "button");
                    addButton.classList.add("btn", "btn-outline-light");
                    addButton.onclick = addCryptoRow;
                    actionCell.appendChild(addButton);
                }
            });
        }

        function addCryptoRow() {
            const table = document.getElementById("cryptoTable").getElementsByTagName("tbody")[0];

            const row = document.createElement("tr");

            const cellISO = document.createElement("td");
            const inputISO = document.createElement("input");
            inputISO.setAttribute("name", "ISO");
            inputISO.setAttribute("type", "text");
            inputISO.setAttribute("required", true);
            inputISO.setAttribute("placeholder", "BTC");
            inputISO.classList.add("form-control", "bg-dark", "text-light");
            cellISO.appendChild(inputISO);

            const cellQty = document.createElement("td");
            const inputQty = document.createElement("input");
            inputQty.setAttribute("type", "number");
            inputQty.setAttribute("min", "0.0");
            inputQty.setAttribute("step", "0.0000001");
            inputQty.setAttribute("required", true);
            inputQty.classList.add("form-control", "bg-dark", "text-light");
            cellQty.appendChild(inputQty);

            const cellButton = document.createElement("td");
            row.appendChild(cellISO);
            row.appendChild(cellQty);
            row.appendChild(cellButton);

            table.appendChild(row);
            updateButtons();
        }

        function removeRow(row) {
            row.remove();
            updateButtons();
        }

        function submitForm(event) {
            event.preventDefault(); // Ne küldje el az alapértelmezett módon
            const rows = document.querySelectorAll("#cryptoTable tbody tr");
            const cryptoData = {};

            rows.forEach(row => {
                const iso = row.querySelector('input[name="ISO"]').value.trim();
                const qty = row.querySelector('input[type="number"]').value.trim();
                
                if (iso && qty) { // Csak ha van érték
                    cryptoData[iso] = parseFloat(qty); // Győződjünk meg róla, hogy számként küldjük
                }
            });

            fetch('/', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ portfolio: cryptoData })
            })
            .then(response => response.json()) // JSON formátumban olvassuk ki a választ
            .then(data => {
                console.log(data);
                document.getElementById("total").innerText = `Total wealth: $${data.total.toFixed(2)}`;
                document.getElementById("timestamp").innerText = data.date;
                document.getElementById("prices").innerText = JSON.stringify(data.prices);
            })
            .catch(error => console.error("Hiba történt:", error));
        }

        document.addEventListener("DOMContentLoaded", function () {
    // Cookie beolvasása és objektummá alakítása
    alert("reloading prevoius data");
    const cookies = document.cookie.split("; ").reduce((acc, cookie) => {
        const [name, value] = cookie.split("=");
        acc[name] = decodeURIComponent(value);
        return acc;
    }, {});

    if (cookies.portfolio) {
        try {
            const portfolioData = JSON.parse(cookies.portfolio);
            const tableBody = document.querySelector("#cryptoTable tbody");
            tableBody.innerHTML = ""; // Töröljük az alapértelmezett sort

            Object.keys(portfolioData).forEach(crypto => {
                const row = document.createElement("tr");

                // ISO kód cella
                const cellISO = document.createElement("td");
                const inputISO = document.createElement("input");
                inputISO.setAttribute("name", "ISO");
                inputISO.setAttribute("type", "text");
                inputISO.setAttribute("required", true);
                inputISO.classList.add("form-control", "bg-dark", "text-light");
                inputISO.value = crypto;
                cellISO.appendChild(inputISO);

                // Mennyiség cella
                const cellQty = document.createElement("td");
                const inputQty = document.createElement("input");
                inputQty.setAttribute("type", "number");
                inputQty.setAttribute("min", "0.0");
                inputQty.setAttribute("step", "0.0000001");
                inputQty.setAttribute("required", true);
                inputQty.classList.add("form-control", "bg-dark", "text-light");
                inputQty.value = portfolioData[crypto];
                cellQty.appendChild(inputQty);

                // Gombok cella
                const cellButton = document.createElement("td");
                row.appendChild(cellISO);
                row.appendChild(cellQty);
                row.appendChild(cellButton);

                tableBody.appendChild(row);
            });

            updateButtons(); // Frissítjük a gombokat
        } catch (error) {
            console.error("Hiba történt a cookie feldolgozásakor:", error);
        }
    }
    else{
        alert("cookie was not found");
    }
});


    </script>
</head>
<body class="d-flex justify-content-center align-items-center vh-100 bg-dark">
    <div class="container">
        <h1 class="text-center mb-4 text-light">Crypto Portfolio</h1>

        <form id="cryptoForm" onsubmit="submitForm(event)">
            <div class="table-responsive">
                <table id="cryptoTable" class="table table-dark table-striped text-center">
                    <thead>
                        <tr>
                            <th>ISO Code</th>
                            <th>Quantity</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><input name="ISO" type="text" required placeholder="BTC" class="form-control bg-dark text-light"></td>
                            <td><input type="number" step="0.000000001" min="0.0" required class="form-control bg-dark text-light"></td>
                            <td><button type="button" onclick="addCryptoRow()" class="btn btn-outline-light">+</button></td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div class="text-center">
                <input type="submit" value="Calculate" class="btn btn-primary mt-3">
            </div>
        </form>
        <h2 class="text-light" id="total"> Total: 0.0$ </h2>
        <p class="text-light" >database last updated from cryptomarketcap.com: <span id="timestamp"> </span></p>
        <p  class="text-light"  id="prices"></p>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
