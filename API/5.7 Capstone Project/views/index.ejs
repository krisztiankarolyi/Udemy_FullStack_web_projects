<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <title>Crypto Portfolio</title>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            if (typeof saved_portfolio !== "undefined" && Object.keys(saved_portfolio).length > 0) {
                Object.entries(saved_portfolio).forEach(([crypto, data]) => {
                    addCryptoRow(crypto, data.quantity, data.price);
                });
                updateButtons();
                calculateTotal(saved_portfolio);
            }
        });

        function updateButtons() {
            const rows = document.querySelectorAll("#cryptoTable tbody tr");
            rows.forEach((row, index) => {
                const actionCell = row.querySelector(".action-cell");
                actionCell.innerHTML = "";

                if (rows.length > 1) {
                    const removeButton = document.createElement("button");
                    removeButton.textContent = "-";
                    removeButton.setAttribute("type", "button");
                    removeButton.classList.add("btn", "btn-outline-danger", "me-1");
                    removeButton.onclick = () => { removeRow(row); };
                    actionCell.appendChild(removeButton);
                }
            });
        }

        function addCryptoRow(crypto = "", quantity = "", price = "?") {
            const table = document.getElementById("cryptoTable").getElementsByTagName("tbody")[0];
            const row = document.createElement("tr");

            row.innerHTML = `
                <td><input name="ISO" type="text" required class="form-control bg-dark text-light" value="${crypto}"></td>
                <td><input name="quantity" type="number" min="0.0" step="0.0000001" required class="form-control bg-dark text-light" value="${quantity}"></td>
                <td class="action-cell"></td>
                <td class="price-cell text-light">${isNaN(price) ? "? $" : parseFloat(price).toFixed(6) + " $"}</td>
            `;

            table.appendChild(row);
            updateButtons();
        }

        function removeRow(row) {
            row.remove();
            updateButtons();
        }

        function submitForm(event) {
            event.preventDefault();
            const rows = document.querySelectorAll("#cryptoTable tbody tr");
            const cryptoData = {};

            rows.forEach(row => {
                const iso = row.querySelector('input[name="ISO"]').value.trim().toUpperCase();
                const qty = row.querySelector('input[name="quantity"]').value.trim();
                
                if (iso && qty && !isNaN(qty) && qty > 0) {
                    cryptoData[iso] = parseFloat(qty);
                }
            });

            fetch('/', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ portfolio: cryptoData })
            })
            .then(response => response.json())
            .then(data => {
                calculateTotal(data.portfolio, data.date);
                updatePrices(data.portfolio);
            })
            .catch(error => console.error("Hiba történt:", error));
        }

        function updatePrices(portfolio) {
            const rows = document.querySelectorAll("#cryptoTable tbody tr");

            rows.forEach(row => {
                const iso = row.querySelector('input[name="ISO"]').value.trim().toUpperCase();
                if (portfolio[iso]) {
                    row.querySelector(".price-cell").textContent = parseFloat(portfolio[iso].price).toFixed(6) + " $";
                }
            });
        }

        function calculateTotal(portfolio, date = null) {
            let total = 0.0;
            Object.values(portfolio).forEach(asset => {
                total += asset.price * asset.quantity;
            });

            if (date) {
                document.getElementById("timestamp").innerText = convertDateTime(date);
            }

            document.getElementById("total").innerText = `Total wealth: $${total.toFixed(6)}`;
        }

        function convertDateTime(date) {
            return new Date(date).toLocaleString('hu-HU', { 
                year: 'numeric', 
                month: 'long', 
                day: 'numeric', 
                hour: '2-digit', 
                minute: '2-digit', 
                second: '2-digit' 
            });
        }
    </script>
</head>
<body class="d-flex justify-content-center align-items-center vh-100 bg-dark">
    <div class="container">
        <h1 class="text-center mb-4 text-light">Crypto Portfolio</h1>
        <script>
            var saved_portfolio = <%- JSON.stringify(saved_portfolio) %> || {};
        </script>
        <form id="cryptoForm" onsubmit="submitForm(event)">
            <div class="table-responsive">
                <table id="cryptoTable" class="table table-dark table-striped text-center">
                    <thead>
                        <tr>
                            <th>ISO Code</th>
                            <th>Quantity</th>
                            <th>Delete</th>
                            <th>Unit price</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><input name="ISO" type="text" required class="form-control bg-dark text-light"></td>
                            <td><input name="quantity" type="number" step="0.000000001" min="0.0" required class="form-control bg-dark text-light"></td>
                            <td class="action-cell"></td>
                            <td class="price-cell text-light">? $</td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div class="text-center">
                <button type="button" onclick="addCryptoRow('','')" class="btn btn-outline-light">+</button>
                <input type="submit" value="Calculate" class="btn btn-primary mt-3">
                <hr>
            </div>
        </form>
        <h2 class="text-light" id="total"> Total: 0.0$ </h2>
        <p class="text-light">Database last updated: <span id="timestamp"></span></p>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
